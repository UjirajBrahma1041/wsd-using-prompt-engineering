{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Assamese WSD Desktop App (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Run Evaluation Benchmark (Headless)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--evaluate"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Run Test Suite (10 Test Scenarios)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test_suite.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
